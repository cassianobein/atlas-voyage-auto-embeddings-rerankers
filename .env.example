# Copy this file to .env and replace the placeholder values.

# MongoDB Atlas
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority"
MONGODB_DB_NAME="ecommerce_demo"

# Atlas Embedding and Reranking API (Voyage AI models)
VOYAGE_API_KEY="<atlas-model-api-key>"
# Bring-Your-Own-Embeddings model
VOYAGE_EMBEDDING_MODEL="voyage-4"
# Reranker model (rerank-3 / rerank-3-lite need an M10+ cluster for $rerank; use rerank-2.5 otherwise)
VOYAGE_RERANK_MODEL="rerank-3"

# Optional
# Model used by the autoEmbed index (defaults to VOYAGE_EMBEDDING_MODEL)
AUTOEMBED_MODEL="voyage-4"
# 256 | 512 | 1024 | 2048
EMBEDDING_DIMENSIONS="1024"
